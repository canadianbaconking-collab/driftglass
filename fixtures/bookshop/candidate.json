{
  "schema_version": 1,
  "default": "deny",
  "rules": [
    { "id": "catalog", "allow": { "tool": "catalog.read", "effect": "READ", "resource": "books/*" } },
    { "id": "shipping", "allow": { "tool": "shipping.create", "effect": "WRITE", "resource": "orders/*" } },
    { "id": "high-risk-deny", "deny": { "tool": "shipping.create", "resource": "orders/high-risk" } },
    { "id": "refund-approval", "require_approval": { "tool": "payments.refund", "effect": "SEND", "resource": "orders/*" } },
    { "id": "vip-deny", "deny": { "tool": "payments.refund", "resource": "orders/vip" } },
    { "id": "notify", "allow": { "tool": "support.notify", "effect": "SEND", "destination": "customers/*" } },
    { "id": "premium-deny", "deny": { "tool": "support.notify", "destination": "customers/premium" } }
  ]
}
