{
  "policy": {
    "schema_version": 1,
    "default": "deny",
    "rules": [
      { "id": "repo-allow", "allow": { "tool": "github.push_files", "resource": "repo/*" } },
      { "id": "repo-secret-deny", "deny": { "tool": "github.push_files", "resource": "repo/secrets" } },
      { "id": "contractor-approval", "require_approval": { "tool": "github.push_files", "actor": "contractor", "resource": "repo/*" } },
      { "id": "repo-read", "allow": { "tool": "github.get_file", "effect": "READ", "resource": "repo/*" } },
      { "id": "release", "allow": { "tool": "deploy.release", "effect": "EXECUTE", "actor": "release" } },
      { "id": "message-approval", "require_approval": { "tool": "slack.send", "effect": "SEND", "destination": "team/*" } },
      { "id": "public-deny", "deny": { "tool": "slack.send", "destination": "team/public" } },
      { "id": "archive-read", "allow": { "tool": "storage.read", "effect": "READ", "resource": "archive/*" } }
    ]
  },
  "cases": [
    { "name": "repo normal", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/app" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo another segment", "event": { "tool": "github.push_files", "effect": "DELETE", "resource": "repo/docs" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo secret deny", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/secrets" }, "decision": "DENY", "winners": ["repo-secret-deny"] },
    { "name": "repo secret contractor deny", "event": { "tool": "github.push_files", "effect": "WRITE", "actor": "contractor", "resource": "repo/secrets" }, "decision": "DENY", "winners": ["repo-secret-deny"] },
    { "name": "repo contractor approval", "event": { "tool": "github.push_files", "effect": "WRITE", "actor": "contractor", "resource": "repo/app" }, "decision": "REQUIRE_APPROVAL", "winners": ["contractor-approval"] },
    { "name": "repo contractor read approval", "event": { "tool": "github.push_files", "effect": "READ", "actor": "contractor", "resource": "repo/docs" }, "decision": "REQUIRE_APPROVAL", "winners": ["contractor-approval"] },
    { "name": "repo absent resource", "event": { "tool": "github.push_files", "effect": "WRITE" }, "decision": "DENY", "winners": [] },
    { "name": "repo bare prefix", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo" }, "decision": "DENY", "winners": [] },
    { "name": "repo nested", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/app/secrets" }, "decision": "DENY", "winners": [] },
    { "name": "repo trailing slash", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/app/" }, "decision": "DENY", "winners": [] },
    { "name": "repo empty segment", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/" }, "decision": "DENY", "winners": [] },
    { "name": "repo case sensitive", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "Repo/app" }, "decision": "DENY", "winners": [] },
    { "name": "tool case sensitive", "event": { "tool": "Github.push_files", "effect": "WRITE", "resource": "repo/app" }, "decision": "DENY", "winners": [] },
    { "name": "literal wildcard in event", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/*" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "read file", "event": { "tool": "github.get_file", "effect": "READ", "resource": "repo/app" }, "decision": "ALLOW", "winners": ["repo-read"] },
    { "name": "write get-file no match", "event": { "tool": "github.get_file", "effect": "WRITE", "resource": "repo/app" }, "decision": "DENY", "winners": [] },
    { "name": "get-file missing resource", "event": { "tool": "github.get_file", "effect": "READ" }, "decision": "DENY", "winners": [] },
    { "name": "release actor", "event": { "tool": "deploy.release", "effect": "EXECUTE", "actor": "release" }, "decision": "ALLOW", "winners": ["release"] },
    { "name": "release wrong actor", "event": { "tool": "deploy.release", "effect": "EXECUTE", "actor": "dev" }, "decision": "DENY", "winners": [] },
    { "name": "release no actor", "event": { "tool": "deploy.release", "effect": "EXECUTE" }, "decision": "DENY", "winners": [] },
    { "name": "release wrong effect", "event": { "tool": "deploy.release", "effect": "READ", "actor": "release" }, "decision": "DENY", "winners": [] },
    { "name": "team private", "event": { "tool": "slack.send", "effect": "SEND", "destination": "team/private" }, "decision": "REQUIRE_APPROVAL", "winners": ["message-approval"] },
    { "name": "team public", "event": { "tool": "slack.send", "effect": "SEND", "destination": "team/public" }, "decision": "DENY", "winners": ["public-deny"] },
    { "name": "team public wrong effect still deny", "event": { "tool": "slack.send", "effect": "READ", "destination": "team/public" }, "decision": "DENY", "winners": ["public-deny"] },
    { "name": "team private wrong effect", "event": { "tool": "slack.send", "effect": "READ", "destination": "team/private" }, "decision": "DENY", "winners": [] },
    { "name": "team deep path", "event": { "tool": "slack.send", "effect": "SEND", "destination": "team/private/thread" }, "decision": "DENY", "winners": [] },
    { "name": "team no destination", "event": { "tool": "slack.send", "effect": "SEND" }, "decision": "DENY", "winners": [] },
    { "name": "archive report", "event": { "tool": "storage.read", "effect": "READ", "resource": "archive/report" }, "decision": "ALLOW", "winners": ["archive-read"] },
    { "name": "archive wrong effect", "event": { "tool": "storage.read", "effect": "DELETE", "resource": "archive/report" }, "decision": "DENY", "winners": [] },
    { "name": "archive deep path", "event": { "tool": "storage.read", "effect": "READ", "resource": "archive/2026/report" }, "decision": "DENY", "winners": [] },
    { "name": "unrelated tool", "event": { "tool": "other.tool", "effect": "SEND" }, "decision": "DENY", "winners": [] },
    { "name": "repo send effect", "event": { "tool": "github.push_files", "effect": "SEND", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo execute effect", "event": { "tool": "github.push_files", "effect": "EXECUTE", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo read effect", "event": { "tool": "github.push_files", "effect": "READ", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo missing actor still allow", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo arbitrary actor", "event": { "tool": "github.push_files", "effect": "WRITE", "actor": "alice", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo contractor wrong case", "event": { "tool": "github.push_files", "effect": "WRITE", "actor": "Contractor", "resource": "repo/web" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo secret case differs", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/Secrets" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "repo deeper secret", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/app/secrets" }, "decision": "DENY", "winners": [] },
    { "name": "repo different root", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "other/app" }, "decision": "DENY", "winners": [] },
    { "name": "repo empty event actor rejected separately", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/x" }, "decision": "ALLOW", "winners": ["repo-allow"] },
    { "name": "read lowercase tool differs", "event": { "tool": "github.get_file", "effect": "READ", "resource": "Repo/app" }, "decision": "DENY", "winners": [] },
    { "name": "read can include actor", "event": { "tool": "github.get_file", "effect": "READ", "actor": "someone", "resource": "repo/app" }, "decision": "ALLOW", "winners": ["repo-read"] },
    { "name": "release extra resource unconstrained", "event": { "tool": "deploy.release", "effect": "EXECUTE", "actor": "release", "resource": "any/path" }, "decision": "ALLOW", "winners": ["release"] },
    { "name": "release extra destination unconstrained", "event": { "tool": "deploy.release", "effect": "EXECUTE", "actor": "release", "destination": "any/path" }, "decision": "ALLOW", "winners": ["release"] },
    { "name": "message actor unconstrained", "event": { "tool": "slack.send", "effect": "SEND", "actor": "bot", "destination": "team/private" }, "decision": "REQUIRE_APPROVAL", "winners": ["message-approval"] },
    { "name": "message public actor unconstrained", "event": { "tool": "slack.send", "effect": "SEND", "actor": "bot", "destination": "team/public" }, "decision": "DENY", "winners": ["public-deny"] },
    { "name": "archive destination irrelevant", "event": { "tool": "storage.read", "effect": "READ", "resource": "archive/report", "destination": "outside" }, "decision": "ALLOW", "winners": ["archive-read"] },
    { "name": "archive case distinct", "event": { "tool": "storage.read", "effect": "READ", "resource": "Archive/report" }, "decision": "DENY", "winners": [] },
    { "name": "valid fractional timestamp", "event": { "tool": "github.push_files", "effect": "WRITE", "resource": "repo/app", "timestamp": "2024-02-29T23:59:59.123456Z" }, "decision": "ALLOW", "winners": ["repo-allow"] }
  ]
}
